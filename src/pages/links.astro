---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aakash Dwivedy | Links</title>
    <meta name="description" content="Aakash Dwivedy — Software Developer (Android). Find all my links here." />
    <meta name="keywords" content="dwivedyaakash, aakash dwivedy, android developer, links, portfolio" />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://dwivedyaakash.github.io/links" />
    <meta property="og:title" content="Aakash Dwivedy — Links" />
    <meta property="og:description" content="Software Developer - Android. All my links in one place." />
    <link rel="icon" type="image/png" href="/favicon.png?v=1" />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      })();
      if (theme === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg: #f0f0f0;
        --surface: #ffffff;
        --surface-hover: #e8e8e8;
        --border: rgba(0,0,0,0.1);
        --text-primary: #111111;
        --text-secondary: #6b7280;
        --shadow: 0 2px 12px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.04);
        --shadow-hover: 0 6px 24px rgba(0,0,0,0.10), 0 2px 6px rgba(0,0,0,0.06);
      }
      .dark {
        --bg: #000000;
        --surface: #111111;
        --surface-hover: #1a1a1a;
        --border: rgba(255,255,255,0.08);
        --text-primary: #ffffff;
        --text-secondary: #9ca3af;
        --shadow: 0 2px 12px rgba(0,0,0,0.5), 0 1px 3px rgba(0,0,0,0.4);
        --shadow-hover: 0 6px 24px rgba(0,0,0,0.6), 0 2px 6px rgba(0,0,0,0.5);
      }
      html, body { min-height: 100vh; font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--text-primary); transition: background 0.3s, color 0.3s; }
      .page { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 2rem 1.25rem 4rem; }
      .top-bar { width: 100%; max-width: 480px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.5rem; }
      .back-link { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary); text-decoration: none; box-shadow: var(--shadow); transition: background 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s; flex-shrink: 0; }
      .back-link:hover { background: var(--surface-hover); color: var(--text-primary); transform: translateX(-2px); box-shadow: var(--shadow-hover); }
      .back-link svg { width: 16px; height: 16px; }
      .theme-btn { background: var(--surface); border: 1px solid var(--border); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow); transition: background 0.2s, box-shadow 0.2s, transform 0.2s; color: var(--text-secondary); flex-shrink: 0; }
      .theme-btn:hover { box-shadow: var(--shadow-hover); transform: scale(1.05); color: var(--text-primary); }
      .theme-btn svg { width: 18px; height: 18px; }
      .card { width: 100%; max-width: 480px; }
      .profile { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; margin-bottom: 2.5rem; }
      .avatar-wrap { position: relative; width: 90px; height: 90px; margin-bottom: 0.4rem; }
      .avatar-ring { position: absolute; inset: -3px; border-radius: 50%; background: white; }
      .dark .avatar-ring { background: white; }
      .avatar-img { position: relative; z-index: 1; width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid var(--bg); display: block; }
      .profile-name { font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text-primary); }
      .profile-bio { font-size: 0.9rem; color: var(--text-secondary); font-weight: 500; }
      .link-item--primary { background: var(--text-primary) !important; color: var(--bg) !important; border-color: transparent !important; }
      .link-item--primary .link-icon { background: rgba(255,255,255,0.15) !important; color: var(--bg) !important; }
      .link-item--primary .link-arrow { color: var(--bg) !important; opacity: 0.7; }
      .link-item--primary:hover { background: var(--text-primary) !important; opacity: 0.88; transform: translateY(-2px); box-shadow: var(--shadow-hover); }
      .link-item--primary:hover .link-icon { background: rgba(255,255,255,0.25) !important; transform: scale(1.08); }
      .link-item--primary:hover .link-arrow { transform: translateX(3px); opacity: 1; }
      .links-list { display: flex; flex-direction: column; gap: 0.875rem; list-style: none; padding: 0; margin: 0 0 2rem; }
      .link-item { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; text-decoration: none; color: var(--text-primary); font-weight: 600; font-size: 0.95rem; box-shadow: var(--shadow); transition: background 0.2s, box-shadow 0.2s, transform 0.2s, border-color 0.2s; position: relative; overflow: hidden; }
      .link-item:hover { background: var(--surface-hover); box-shadow: var(--shadow-hover); transform: translateY(-2px); border-color: var(--text-secondary); }
      .link-icon { flex-shrink: 0; width: 40px; height: 40px; border-radius: 10px; background: rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; color: var(--text-primary); transition: background 0.2s, transform 0.2s; }
      .dark .link-icon { background: rgba(255,255,255,0.07); }
      .link-item:hover .link-icon { background: var(--text-primary); color: var(--bg); transform: scale(1.08); }
      .link-icon svg { width: 18px; height: 18px; }
      .link-label { flex: 1; }
      .link-arrow { flex-shrink: 0; width: 16px; height: 16px; color: var(--text-secondary); transition: transform 0.2s, color 0.2s; }
      .link-item:hover .link-arrow { transform: translateX(3px); color: var(--text-primary); }
      .fade-in { opacity: 0; transform: translateY(16px); animation: fadeInUp 0.5s ease forwards; }
      @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
      .fade-in:nth-child(1) { animation-delay: 0.05s; }
      .fade-in:nth-child(2) { animation-delay: 0.1s; }
      .fade-in:nth-child(3) { animation-delay: 0.15s; }
      .fade-in:nth-child(4) { animation-delay: 0.2s; }
      .fade-in:nth-child(5) { animation-delay: 0.25s; }
      .fade-in:nth-child(6) { animation-delay: 0.3s; }
      .fade-in:nth-child(7) { animation-delay: 0.35s; }
      .fade-in:nth-child(8) { animation-delay: 0.4s; }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="top-bar fade-in">
        <a href="/" class="back-link" aria-label="Back to portfolio">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
        </a>
        <button class="theme-btn" id="theme-toggle" aria-label="Toggle dark mode">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="display:none">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="display:none">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>
      </div>

      <div class="card">
        <div class="profile fade-in">
          <div class="avatar-wrap">
            <div class="avatar-ring"></div>
            <img class="avatar-img" src="/aakash.jpg" alt="Aakash Dwivedy" />
          </div>
          <h1 class="profile-name">Aakash Dwivedy</h1>
          <p class="profile-bio">Software Developer &middot; Android</p>
        </div>

        <nav aria-label="Profile links">
          <ul class="links-list">
            {links.map((link) => (
              <li class="fade-in">
                <a
                  class={`link-item${link.primary ? ' link-item--primary' : ''}`}
                  href={link.url}
                  target={link.url.startsWith('http') ? '_blank' : undefined}
                  rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  aria-label={link.label}
                >
                  <span class="link-icon" aria-hidden="true" set:html={link.icon} />
                  <span class="link-label">{link.label}</span>
                  <svg class="link-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <script is:inline>
      const html = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const sun = document.getElementById('icon-sun');
      const moon = document.getElementById('icon-moon');
      const updateIcons = (dark) => {
        if (sun) sun.style.display = dark ? 'block' : 'none';
        if (moon) moon.style.display = dark ? 'none' : 'block';
      };
      updateIcons(html.classList.contains('dark'));
      btn?.addEventListener('click', () => {
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons(isDark);
      });
    </script>
  </body>
</html>
